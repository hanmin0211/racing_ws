digraph localization {
  rankdir=TB;
  bgcolor="white";
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  caster [label="NGII VRS caster", shape=box, style="filled,dashed", fillcolor="#f0f0f0", fontsize=10];
  f9p    [label="u-blox ZED-F9P", shape=box, style="filled,dashed", fillcolor="#f0f0f0", fontsize=10];
  imuhw  [label="HandsFree A9 IMU", shape=box, style="filled,dashed", fillcolor="#f0f0f0", fontsize=10];

  ntrip  [label="/ngii_vrs_ntrip_client", shape=ellipse, style=filled, fillcolor="#cfe8fc"];
  ublox  [label="/ublox_dgnss", shape=ellipse, style=filled, fillcolor="#cfe8fc"];
  imu    [label="/imu", shape=ellipse, style=filled, fillcolor="#cfe8fc"];
  hinit  [label="/gps_heading_init", shape=ellipse, style=filled, fillcolor="#cfe8fc"];
  loc    [label="/direct_localization", shape=ellipse, style=filled, fillcolor="#a8d5a2"];
  ctrl   [label="/local_pure_pursuit", shape=ellipse, style=filled, fillcolor="#ffe0b2"];

  t_rtcm [label="/ntrip_client/rtcm", shape=box, style=filled, fillcolor="#fff9c4"];
  t_fix  [label="/fix", shape=box, style=filled, fillcolor="#fff9c4"];
  t_imu  [label="/handsfree/imu", shape=box, style=filled, fillcolor="#fff9c4"];
  t_off  [label="/heading/yaw_offset", shape=box, style=filled, fillcolor="#fff9c4"];
  t_odom [label="/odometry/filtered", shape=box, style=filled, fillcolor="#fff9c4"];

  ntrip  -> caster [label="GGA", style=dashed];
  caster -> ntrip  [label="RTCM3", style=dashed];
  ntrip  -> t_rtcm;
  t_rtcm -> ublox;
  ublox  -> f9p    [label="USB", style=dashed];
  f9p    -> ublox  [style=dashed];
  ublox  -> t_fix;
  imuhw  -> imu    [label="USB", style=dashed];
  imu    -> t_imu;

  t_fix  -> hinit;
  t_imu  -> hinit;
  hinit  -> t_off;

  t_fix  -> loc;
  t_imu  -> loc;
  t_off  -> loc;
  loc    -> t_odom;
  t_odom -> ctrl;

  { rank=same; ntrip; ublox; }
  { rank=same; t_fix; t_imu; }
}
