# lidar_check.rviz — 라이다 단독 확인용 (드라이버만 떠 있으면 된다).
#
# ★ Fixed Frame 이 'laser' 다.
#   /scan 의 frame_id 가 laser 인데, 로컬라이제이션을 안 띄우면 TF 가 하나도
#   없어서 map/base_link 로 두면 "Frame [laser] does not exist" 로 아무것도
#   안 그려진다. 라이다만 볼 때는 센서 프레임을 그대로 쓰는 게 맞다.
#
# ★ 가운데 좌표축이 센서의 0° 방향이다(빨강=+x). 차 정면에 물체를 놓고
#   그 물체가 빨강축 쪽에 보이면 fg_yaw_offset_deg:=0,
#   반대(뒤)쪽에 보이면 180 이다. tools/lidar_orient.py 가 숫자로 확정해 준다.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid(1m)
      Enabled: true
      Color: 70; 70; 70
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: laser
    - Class: rviz_default_plugins/Axes
      Name: 센서원점(빨강=0°)
      Enabled: true
      Reference Frame: laser
      Length: 1
      Radius: 0.05
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 0; 255; 120
      Decay Time: 0
  Global Options:
    Fixed Frame: laser
    Background Color: 25; 25; 30
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 12
      Pitch: 1.3
      Yaw: 3.14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
