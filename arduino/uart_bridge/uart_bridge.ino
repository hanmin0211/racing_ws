// =============================================================================
// uart_bridge.ino — ms2405 가 Serial2(D17) 로 보내는 115200bps 스트림을 그대로 중계
// -----------------------------------------------------------------------------
// 발견(2026-08-20): bus_scan 결과 D17(Serial2 RX)에 **115200bps UART 데이터**가
// 흐르고 있었다. ascii 로 "Frame Lost or FailSafe" 가 읽혔다.
// (그전 펄스 스캔에서 D17 이 뛰었는데 정지 중에도 뛴다고 노이즈로 오판했던 그 신호다
//  — UART 주기 전송이면 정지 중에도 뛰는 게 정상이다.)
//
// 목적: 스트림 전문을 USB 시리얼로 그대로 넘겨, ms2405 가 무엇을 보내는지 확인한다.
//       특히 **엔코더 카운트/속도**가 이 스트림에 실려 있는지(바퀴를 굴렸을 때
//       변하는 숫자가 있는지)를 본다.
//
// 사용: 플래시 후 USB 시리얼 57600 으로 관찰. 바퀴를 굴리며 값 변화를 본다.
// ※ 끝나면 henes_firmware 재플래시.
// =============================================================================

void setup() {
  Serial.begin(57600);      // USB (PC)
  Serial2.begin(115200);    // ms2405 → 아두이노 (D17=RX2)
  delay(500);
  Serial.println();
  Serial.println("=== ms2405 Serial2(115200) 스트림 중계 시작 ===");
}

void loop() {
  while (Serial2.available()) {
    Serial.write(Serial2.read());
  }
}
