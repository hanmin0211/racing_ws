#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
import numpy as np
import math
import os
import yaml

from sensor_msgs.msg import NavSatFix
from std_msgs.msg import Float32, Float32MultiArray
from nav_msgs.msg import Path
from geometry_msgs.msg import PoseStamped
from geometry_msgs.msg import TransformStamped

# --- TF 변환 및 정석 쿼터니언 라이브러리 연동 ---
from tf2_ros import TransformBroadcaster

class VehicleTransformNode(Node):
    def __init__(self):
        super().__init__('vehicle_transform')

        # --- 파라미터 세팅 및 변수 초기화 ---
        self.declare_parameter('lookahead_window', 15.0) # 실전용 15.0미터 규격 유지
        self.declare_parameter('filter_alpha', 0.2)
        default_yaml_path = os.path.expanduser('~/gps_converter/waypoints_local_resampled_0.3.yaml') # 6천개 보간 맵 지정
        self.declare_parameter('yaml_path', default_yaml_path)

        self.lookahead_window = self.get_parameter('lookahead_window').value
        self.alpha = self.get_parameter('filter_alpha').value
        yaml_path = self.get_parameter('yaml_path').value

        self.is_origin_set = False
        self.origin_lat = 0.0
        self.origin_lon = 0.0

        self.current_x = 0.0
        self.current_y = 0.0
        self.current_heading = 0.0
        self.prev_heading = None

        # --- 웨이포인트 데이터 로드 ---
        self.global_waypoints = []
        self.load_waypoints_from_yaml(yaml_path)

        # --- 구독자 및 발행자 세팅 ---
        self.sub_gps = self.create_subscription(NavSatFix, '/fix', self.gps_callback, 10)
        self.sub_heading = self.create_subscription(Float32, '/heading', self.heading_callback, 10)
        
        self.pub_coeffs = self.create_publisher(Float32MultiArray, '/path_polynomial_coeffs', 10)
        self.pub_rmse = self.create_publisher(Float32, '/path_fit_rmse', 10)
        self.pub_global_path = self.create_publisher(Path, '/vehicle_frame_path', 10) # map 프레임용
        self.pub_local_path = self.create_publisher(Path, '/local_path', 10)          # base_link 프레임용

        self.tf_broadcaster = TransformBroadcaster(self)

        # 실내 시뮬레이션 주행용 무한 루프 인덱스
        self.sim_index = 0

        self.get_logger().info("📐 [최종 수리 완] 6천개 맵 정밀 결합 계산기 시동")

    def load_waypoints_from_yaml(self, path):
        if os.path.exists(path):
            with open(path, 'r') as f:
                data = yaml.safe_load(f)
            pts = []
            if 'waypoints' in data and data['waypoints'] is not None:
                for wp in data['waypoints']:
                    pts.append([wp['x'], wp['y']])
                self.global_waypoints = np.array(pts)
                self.get_logger().info(f"📂 성공적으로 {len(self.global_waypoints)}개의 고정밀 샘플링 웨이포인트를 로드했습니다.")
        else:
            self.get_logger().error(f"❌ 보간 맵 파일을 찾을 수 없습니다: {path}")

    def gps_callback(self, msg):
        if math.isnan(msg.latitude) or math.isnan(msg.longitude):
            return

        if not self.is_origin_set:
            self.origin_lat = msg.latitude
            self.origin_lon = msg.longitude
            self.is_origin_set = True
            self.get_logger().info(f"🎯 기준점 실시간 고정 완료: Lat={self.origin_lat}, Lon={self.origin_lon}")
            
        if len(self.global_waypoints) == 0:
            return

        # [실내 가상 무한 주행 구속] 6140개 인덱스를 안전하게 순환 동기화하여 전진하게 조치
        self.sim_index = (self.sim_index + 1) % len(self.global_waypoints)
        target_wp = self.global_waypoints[self.sim_index]
        
        # 2차원 배열 원소를 순수 스칼라 실수형태로 정확히 추출
        self.current_x = float(target_wp[0])
        self.current_y = float(target_wp[1])

       # === [추가] 6140개 맵의 실제 곡률 방위각을 실시간 가상 헤딩으로 강제 동기화 ===
# 다음 점과의 위치 차이를 통해 실제 트랙이 꺾이는 정밀 라디안 각도를 역산합니다.
        next_wp = self.global_waypoints[(self.sim_index + 1) % len(self.global_waypoints)]
        self.current_heading = math.atan2(float(next_wp[1]) - self.current_y, float(next_wp[0]) - self.current_x)


        self.process_path_planning()
        self.publish_tf()

    def heading_callback(self, msg):
        raw_heading = math.radians(msg.data)
        
        if self.prev_heading is None:
            self.prev_heading = raw_heading
            self.current_heading = raw_heading
            return

        diff = raw_heading - self.prev_heading
        if diff > math.pi:
            raw_heading -= 2 * math.pi
        elif diff < -math.pi:
            raw_heading += 2 * math.pi

        self.current_heading = self.alpha * raw_heading + (1.0 - self.alpha) * self.prev_heading
        self.current_heading = (self.current_heading + 2 * math.pi) % (2 * math.pi)
        self.prev_heading = self.current_heading

    def process_path_planning(self):
        if len(self.global_waypoints) == 0:
            return

        cos_h = math.cos(self.current_heading)
        sin_h = math.sin(self.current_heading)

        local_pts_x = []
        local_pts_y = []

        # === [완벽 차단] wp[0], wp[1]로 나누어 넘파이 차원 붕괴 버그 근본적 해결 ===
        for wp in self.global_waypoints:
            dx = float(wp[0]) - self.current_x
            dy = float(wp[1]) - self.current_y

            rx = dx * cos_h + dy * sin_h
            ry = -dx * sin_h + dy * cos_h

            if -5.0 <= rx <= self.lookahead_window:
                local_pts_x.append(rx)
                local_pts_y.append(ry)

        num_pts = len(local_pts_x)
        coeffs = [0.0, 0.0, 0.0, 0.0]
        rmse_val = 0.0

        if num_pts < 2:
            self.publish_data(coeffs, 999.0, local_pts_x, local_pts_y)
            return

        try:
            if num_pts >= 4:
                degree = 3
            else:
                degree = 1
                
            poly_fit_raw = np.polyfit(local_pts_x, local_pts_y, degree)
            y_fit = np.polyval(poly_fit_raw, local_pts_x)
            rmse_val = float(np.sqrt(np.mean((local_pts_y - y_fit) ** 2)))
            
            poly_fit_reversed = poly_fit_raw[::-1]
            
            if degree == 3:
                coeffs = list(poly_fit_reversed[:4])
            elif degree == 1:
                coeffs = [float(poly_fit_reversed[0]), float(poly_fit_reversed[1]), 0.0, 0.0]

        except np.linalg.LinAlgError:
            rmse_val = 999.0
            coeffs = [0.0, 0.0, 0.0, 0.0]

        if np.any(np.abs(coeffs) > 15.0):
            coeffs = [0.0, 0.0, 0.0, 0.0]

        self.publish_data(coeffs, rmse_val, local_pts_x, local_pts_y)

    def publish_data(self, coeffs, rmse, pts_x, pts_y):
        msg_coeffs = Float32MultiArray()
        msg_coeffs.data = coeffs
        self.pub_coeffs.publish(msg_coeffs)

        msg_rmse = Float32()
        msg_rmse.data = rmse
        self.pub_rmse.publish(msg_rmse)

        # 1. Local Path (base_link 프레임 축)
        path_msg = Path()
        path_msg.header.stamp = self.get_clock().now().to_msg()
        path_msg.header.frame_id = "base_link"

        for x, y in zip(pts_x, pts_y):
            pose = PoseStamped()
            pose.pose.position.x = float(x)
            pose.pose.position.y = float(y)
            pose.pose.position.z = 0.0
            path_msg.poses.append(pose)
        self.pub_local_path.publish(path_msg)

        # 2. Global Path (map 프레임 축)
        global_path = Path()
        global_path.header.stamp = self.get_clock().now().to_msg()
        global_path.header.frame_id = "map"

        # [완벽 차단] 시각화 퍼블리시 단의 인덱스 추출 정밀 마감 완료
        for wp in self.global_waypoints:
            pose = PoseStamped()
            pose.pose.position.x = float(wp[0])
            pose.pose.position.y = float(wp[1])
            pose.pose.position.z = 0.0
            global_path.poses.append(pose)
        self.pub_global_path.publish(global_path)

    def publish_tf(self):
        t = TransformStamped()
        t.header.stamp = self.get_clock().now().to_msg()
        t.header.frame_id = "map"
        t.child_frame_id = "base_link"

        t.transform.translation.x = self.current_x
        t.transform.translation.y = self.current_y
        t.transform.translation.z = 0.0

        # 고정밀 Z, W 기하 변환 직결 정렬
        t.transform.rotation.x = 0.0
        t.transform.rotation.y = 0.0
        t.transform.rotation.z = float(math.sin(self.current_heading / 2.0))
        t.transform.rotation.w = float(math.cos(self.current_heading / 2.0))

        self.tf_broadcaster.sendTransform(t)

def main(args=None):
    rclpy.init(args=args)
    node = VehicleTransformNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
