<?xml version="1.0"?>
<package format="3">
  <name>lidar_clustering</name>
  <version>0.1.0</version>
  <description>2D LiDAR clustering, Hungarian tracking and Follow-the-Gap planning</description>
  <maintainer email="team@example.com">team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
